# =====================================================================
# Model configuration — one provider + model per role (OpenAI-compatible endpoints).
# Default: REMOTE free tiers only. No local software required.
#
# Minimum to run everything: ONE free key (GROQ_API_KEY).
# The judge uses a different model FAMILY (Qwen) from the agent (OpenAI gpt-oss)
# so they don't share blind spots. With a GEMINI_API_KEY you can move the
# judge/reflector to Gemini instead (see below).
#
# Ollama is OPTIONAL: set any role's provider to "ollama" if you have it
# running on the host (e.g. AGENT_PROVIDER=ollama, AGENT_MODEL=qwen3:8b).
# Free-tier quotas change — nothing in the code assumes specific limits.
# =====================================================================

# Free/developer-tier Groq chat models (checked Oct 2026): openai/gpt-oss-20b, openai/gpt-oss-120b,
# openai/gpt-oss-safeguard-20b, qwen/qwen3.8-27b (preview). Llama chat models are Enterprise-only.
# `make doctor` lists the IDs your key can use if a model returns 404.

# High-volume roles
AGENT_PROVIDER=groq
AGENT_MODEL=openai/gpt-oss-20b

SIMULATOR_PROVIDER=groq
SIMULATOR_MODEL=openai/gpt-oss-120b

GUARD_PROVIDER=groq
GUARD_MODEL=openai/gpt-oss-20b
# (the guard also has a deterministic regex layer that does not depend on any model)

# Low-volume quality roles. The judge is a DIFFERENT model family (Qwen) from the agent and the
# simulator it grades. qwen3.8-27b is a preview model; if it is withdrawn, doctor will show it and
# you can set JUDGE_MODEL=openai/gpt-oss-120b (same family as the agent - weaker independence).
JUDGE_PROVIDER=groq
JUDGE_MODEL=qwen/qwen3.8-27b

REFLECTOR_PROVIDER=groq
REFLECTOR_MODEL=openai/gpt-oss-120b

# ---------------------------------------------------------------------
# Optional second provider: Gemini API (Google's OpenAI-compatible endpoint)
# Model IDs verified on ai.google.dev/gemini-api/docs/models (Oct 2026, both STABLE).
# Check them with your key, without touching the roles above:
#     make doctor ARGS="--provider gemini"
# To USE Gemini for a role, set e.g. AGENT_PROVIDER=gemini AGENT_MODEL=gemini-3.8-flash.
# Start a NEW eval run after switching - runs pin their models and refuse to resume with different ones.
#
#   agent / simulator / judge / reflector -> gemini-3.8-flash
#   guard (lightweight classifier)        -> gemini-3.5-flash-lite
#
# Note: an all-Gemini setup makes the judge the same family as the agent; a Gemini agent with the
# Groq Qwen judge (JUDGE_PROVIDER=groq JUDGE_MODEL=qwen/qwen3.8-27b) keeps them independent.
#
# Gemini 3.x "thinks" before answering, and thinking tokens count against max_tokens. The client
# therefore sends reasoning_effort (low|medium|high; default low) and adds headroom to max_tokens:
# GEMINI_REASONING_EFFORT=low          # or per role: AGENT_REASONING_EFFORT=medium
# GEMINI_THINKING_HEADROOM=1024
# Override a profile model if needed:  GEMINI_AGENT_MODEL=..., GEMINI_GUARD_MODEL=...
# ---------------------------------------------------------------------

# ---------------------------------------------------------------------
# Optional: local models with Ollama (no quota; runs on the host, reached from Docker below).
# Tested low-memory profile: agent+guard qwen3.5:4b, simulator gemma3:4b (different family),
# judge+reflector on Groq openai/gpt-oss-120b (different family from both), or fully local / no quota:
# judge+reflector llama3.1:8b (Meta: a third family, so the judge shares no blind spots with either).
#   AGENT_PROVIDER=ollama     AGENT_MODEL=qwen3.5:4b
#   SIMULATOR_PROVIDER=ollama SIMULATOR_MODEL=gemma3:4b    SIMULATOR_REASONING_EFFORT=default
#   GUARD_PROVIDER=ollama     GUARD_MODEL=qwen3.5:4b
#   JUDGE_PROVIDER=groq       JUDGE_MODEL=openai/gpt-oss-120b
#   (fully local) JUDGE_PROVIDER=ollama JUDGE_MODEL=llama3.1:8b JUDGE_REASONING_EFFORT=default
#                 REFLECTOR_PROVIDER=ollama REFLECTOR_MODEL=llama3.1:8b REFLECTOR_REASONING_EFFORT=default
# Thinking models: OLLAMA_REASONING_EFFORT=none (default) turns thinking off; low|medium|high turns it on
# (OLLAMA_THINKING_HEADROOM tokens are then added to max_tokens). "default" = don't send the setting.
# ---------------------------------------------------------------------

# API keys (free sign-up). Never commit the real .env.
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Only used if a role's provider is "ollama" (Ollama running natively on the host).
OLLAMA_API_BASE=http://host.docker.internal:11434
